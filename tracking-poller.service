[Unit]
Description=MCP Tracking Poller (qBittorrent + Bazarr)
After=network.target tracking-api.service
Requires=tracking-api.service

[Service]
Type=simple
User=amineutron
WorkingDirectory=/home/amineutron/dev/MCP/tracking
ExecStart=/home/amineutron/dev/MCP/tracking/.venv/bin/python /home/amineutron/dev/MCP/tracking/poller.py
Restart=always
RestartSec=5
StandardOutput=journal
StandardError=journal
Environment=PYTHONUNBUFFERED=1

# Secrets : blobs credentials/*.cred chiffres en mode --user par
# media-server/scripts/secrets/rotate-secrets.sh. Ce service systeme tourne en
# tant qu'amineutron : poller.py les dechiffre lui-meme via
# `systemd-creds decrypt --user` (LoadCredentialEncrypted ne s'applique qu'aux
# credentials chiffres avec la cle systeme).

NoNewPrivileges=true

[Install]
WantedBy=multi-user.target
